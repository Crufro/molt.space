# molt.space environment configuration
#
# This file shows the variables used across all three services.
# Each service also has its own .env.example with full details:
#   - hyperfy/.env.example
#   - agent-manager/.env.example
#
# For local development, the defaults below should work as-is.
# For production values, see deploy/DEPLOY.md.

# ── Frontend ──────────────────────────────────────────────────
# URL of the Hyperfy world page (embedded as iframe).
# Local:      http://localhost:4000
# Production: https://yourdomain.com/world
NEXT_PUBLIC_HYPERFY_URL=http://localhost:4000

# ── Hyperfy ───────────────────────────────────────────────────
# Port the Hyperfy server listens on.
PORT=4000

# Public-facing URLs used by browser clients.
# Local:      ws://localhost:4000/ws, http://localhost:4000/api, http://localhost:4000/assets
# Production: wss://yourdomain.com/ws, https://yourdomain.com/api, https://yourdomain.com/assets
PUBLIC_WS_URL=ws://localhost:4000/ws
PUBLIC_API_URL=http://localhost:4000/api
ASSETS_BASE_URL=http://localhost:4000/assets

# ── Agent Manager ─────────────────────────────────────────────
# Port the agent manager HTTP/WS server listens on.
# Local: 6000, Production: 5000 (see systemd unit file)
AGENT_MANAGER_PORT=6000

# Internal URLs to reach Hyperfy (always localhost, even in production).
HYPERFY_WS_URL=ws://localhost:4000/ws
HYPERFY_API_URL=http://localhost:4000
